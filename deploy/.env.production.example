# Copy to deploy/.env.production on the server and keep mode 0600.
POSTGRES_USER=blog
POSTGRES_DB=personal_blog
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
SECRET_KEY=

# The first bootstrap command creates this administrator. Keep the password
# out of Git and chat; enter it only in deploy/.env.production on the server.
ADMIN_USERNAME=guoer9
ADMIN_EMAIL=admin@guoer9.me
ADMIN_PASSWORD=
ADMIN_UPDATE_PASSWORD=false

CORS_ORIGINS=["http://39.96.212.169:8080","https://guoer9.me","https://www.guoer9.me"]
NOTION_SYNC_ENABLED=false
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
NPM_REGISTRY=https://registry.npmmirror.com

# Optional build-only proxy. For this Linux server's loopback Mihomo listener,
# use BUILD_NETWORK=host and BUILD_PROXY_URL=http://127.0.0.1:7890.
BUILD_NETWORK=default
BUILD_PROXY_URL=
