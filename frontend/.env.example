# API 基础 URL。生产环境由部署配置提供；本地开发使用 Vite 代理。
VITE_API_BASE_URL=/api/v1

# Copy this file to .env.local; keep real credentials out of Git and chat.
# SDK stays disabled until both ENABLED=true and a project DSN are set.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Read-only Sentry issue queries. These are NOT browser variables.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_BASE_URL=https://sentry.io
SENTRY_ENVIRONMENT=production

# BrowserStack Automate + Local. Never prefix these credentials with VITE_.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_BROWSER=playwright-chromium
BROWSERSTACK_OS=Windows
BROWSERSTACK_OS_VERSION=11
BROWSERSTACK_PROJECT=Personal Blog

# Use 4173 for production preview, 5173 for local development.
QUALITY_BASE_URL=http://127.0.0.1:4173
