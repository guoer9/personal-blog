{
  "name": "frontend",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "quality:doctor": "node --env-file-if-exists=.env.local scripts/quality/doctor.mjs",
    "audit:axe": "node --env-file-if-exists=.env.local scripts/quality/axe.mjs",
    "audit:lighthouse": "node --env-file-if-exists=.env.local scripts/quality/lighthouse.mjs",
    "browserstack:check": "node --env-file-if-exists=.env.local scripts/quality/browserstack.mjs --check",
    "test:browserstack": "node --env-file-if-exists=.env.local scripts/quality/browserstack.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@sentry/vue": "11.10.0",
    "axios": "^1.13.3",
    "element-plus": "^2.13.1",
    "markdown-it": "^14.1.0",
    "md-editor-v3": "^6.3.1",
    "pinia": "^3.0.4",
    "three": "^0.187.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "browserstack-local": "1.5.16",
    "chrome-launcher": "1.2.2",
    "happy-dom": "^21.0.4",
    "lighthouse": "13.6.0",
    "playwright": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.4"
  }
}
