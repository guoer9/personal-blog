# 本地数据库配置（docker-compose 映射到主机 5433）
DATABASE_URL=postgresql+asyncpg://bloguser:local-dev-password@localhost:5433/blogdb

# JWT 配置
# 生成密钥: openssl rand -hex 32
SECRET_KEY=generate-a-local-secret-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# 发布副本经API校验引用后读取，不静态挂载；三个目录互不重叠（包括父目录）。
PUBLIC_MEDIA_DIR=public-media
WORK_ASSET_QUOTA_BYTES=10737418240
PRIVATE_STORAGE_DIR=private-library
LIBRARY_MAX_FILE_BYTES=8589934592
LIBRARY_QUOTA_BYTES=53687091200
LIBRARY_SESSION_TTL_SECONDS=86400
# Notion integration (read-only, explicit admin actions only).
# Export this variable in the API process environment; its default relative
# path is resolved from the process working directory. Local Compose sets an
# absolute path, /run/secrets/notion-connections.json, for its read-only mount.
NOTION_CONNECTIONS_FILE=.secrets/notion-connections.json
# Compatibility settings for the first single-source status/sync endpoints.
# New source imports and syncs do not read these values.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# Kept for compatibility status responses; application startup does not start
# a Notion scheduler and this must remain false for local development.
NOTION_SYNC_ENABLED=false
NOTION_SYNC_INTERVAL_SECONDS=300
# 定期清理过期上传分片（在 backend 目录运行；不会删除入库文件或回收站）：
# venv/bin/python -m app.services.library_cleanup

# 环境
ENVIRONMENT=development
