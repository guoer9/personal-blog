<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.guoer.hapi-desktop-attach</string>
  <key>ProgramArguments</key><array>
    <string>__HAPI_BINARY__</string><string>attach</string><string>__NATIVE_THREAD_ID__</string>
    <string>--socket</string><string>__PRIVATE_SOCKET_PATH__</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HAPI_HOME</key><string>__HAPI_HOME__</string>
    <key>HAPI_API_URL</key><string>https://codex.guoer9.me</string>
    <key>HAPI_DISABLE_PEER_TOOLS</key><string>1</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HAPI_HOME__/logs/desktop-attach.log</string>
  <key>StandardErrorPath</key><string>__HAPI_HOME__/logs/desktop-attach.log</string>
</dict></plist>
