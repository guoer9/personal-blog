FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN useradd --uid 10001 --create-home blog && mkdir -p /data/private /data/publication /data/uploads /data/transfers && chown -R blog:blog /data
COPY --chown=blog:blog app /app/app
COPY --chown=blog:blog alembic /app/alembic
COPY --chown=blog:blog alembic.ini /app/alembic.ini
USER blog
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
