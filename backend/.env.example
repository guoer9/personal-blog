# 本地数据库配置（docker-compose 映射到主机 5433）
DATABASE_URL=postgresql+asyncpg://bloguser:local-dev-password@localhost:5433/blogdb

# JWT 配置
# 生成密钥: openssl rand -hex 32
SECRET_KEY=generate-a-local-secret-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# 环境
ENVIRONMENT=development
