[Unit]
Description=Personal Blog Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/personal-blog
ExecStart=/usr/bin/docker compose --env-file /srv/personal-blog/deploy/.env.production -f /srv/personal-blog/deploy/compose.production.yml up -d
ExecStop=/usr/bin/docker compose --env-file /srv/personal-blog/deploy/.env.production -f /srv/personal-blog/deploy/compose.production.yml stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
